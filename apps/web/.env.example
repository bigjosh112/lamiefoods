# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
#
# Only NEXT_PUBLIC_* values reach the browser bundle — everything else here is
# server-only (config/server-env.ts, guarded with the `server-only` package).
# The backend is this same app now (apps/web/src/app/api/), not a separate
# `apps/backend` service — see CLAUDE.md rule 10 and architecture.md's
# 2026-09-07 decision log.

# ── Public (client + server) ────────────────────────────────────────────────

# Canonical origin, used for metadataBase, canonical URLs, sitemap, robots,
# and as the default base for apiFetch when NEXT_PUBLIC_API_URL is unset.
# No trailing slash. Production (Railway @lamiefoods/web): set this to the
# public origin, e.g. https://shoplamiefoods.com — not a Railway
# ${{VAR}} self-reference, and not localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only for a genuinely external backend later. Leave unset for the normal
# case — apiFetch resolves against NEXT_PUBLIC_SITE_URL instead.
# NEXT_PUBLIC_API_URL=

# Paystack PUBLIC key only (starts with pk_). The secret key is below, and
# must never move up into a NEXT_PUBLIC_* var.
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ── Server-only ──────────────────────────────────────────────────────────────

# Postgres connection string (Supabase today, Railway later — see
# config/server-env.ts). Without it, ordering returns an honest 503 and the
# admin panel has nothing to show; nothing crashes.
# On Railway @lamiefoods/web: DATABASE_URL=${{Postgres.DATABASE_URL}}
# (runtime + Console). Image build cannot reach postgres.railway.internal;
# ISR pages fail-soft if the query throws.
# On Supabase: use the TRANSACTION POOLER string (port 6543), not the direct
# connection — serverless functions exhaust the direct-connection limit fast.
# DATABASE_URL=

# Resend API key + verified sender. Without both, orders still save — email
# is best-effort and is simply skipped.
# Adding a domain in Resend is not enough: ORDER_EMAIL_FROM must be a mailbox
# ON that verified domain, with angle brackets. If you verified
# contact.shoplamiefoods.com, FROM is e.g.
#   ORDER_EMAIL_FROM="Lamie Foods <hello@contact.shoplamiefoods.com>"
# gmail.com / yahoo / outlook FROM addresses are always rejected (422).
# Restart `next` after changing these — serverEnv is cached.
# RESEND_API_KEY=
# ORDER_EMAIL_FROM="Lamie Foods <orders@lamiefoods.com>"
# Where the shop's own new-order notification goes. Optional even with the
# above set.
# ORDER_EMAIL_TO=

# Paystack SECRET key (starts with sk_). Verifies transactions and the
# webhook signature. Without it, the "Pay online" option is unavailable and
# checkout falls back to bank transfer only.
# PAYSTACK_SECRET_KEY=

# Admin sign-in — one shared credential. ADMIN_EMAIL + ADMIN_SESSION_SECRET +
# DATABASE_URL are required. ADMIN_PASSWORD_HASH seeds `admin_auth` on first
# use (migration 0009); after that the live hash is in the DB (forgot/reset
# can change it). See server/admin/auth.ts / password.ts.
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET=

# Vercel Blob's long-lived read-write token (`vercel_blob_rw_…`), for admin
# product-photo upload (components/admin/image-upload.tsx). Create a Blob
# store on a Vercel project (Storage tab) and copy the token — Railway does
# not mint one. On Railway this MUST be on @lamiefoods/web, never the
# retired @lamiefoods/backend stub; otherwise /admin/products/new hides the
# Add tile and shows "Image upload isn't connected yet". Without it, products
# can still be saved, just without photos.
# BLOB_READ_WRITE_TOKEN=
