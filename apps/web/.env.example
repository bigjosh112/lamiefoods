# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
#
# Only NEXT_PUBLIC_* values reach the browser bundle. Never put a secret behind
# that prefix — Paystack secret keys, database URLs and admin credentials belong
# to apps/backend, not here.

# Canonical origin, used for metadataBase, canonical URLs, sitemap and robots.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the API from apps/backend. Leave unset until the backend
# developer provides it; the frontend treats "no API configured" as a
# first-class state rather than guessing a URL.
# NEXT_PUBLIC_API_URL=

# Paystack PUBLIC key only (starts with pk_). The secret key stays server-side
# in apps/backend.
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
